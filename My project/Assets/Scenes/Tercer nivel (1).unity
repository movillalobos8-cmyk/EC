  scriptsAMoverOApagar: []
  secretariaImage: {fileID: 1813204489}
  idleSprite: {fileID: 3362502459059612975, guid: affcb8cf693564742870e733a54a4b19, type: 3}
  talkingSprite: {fileID: 3608271148486519149, guid: bbc8571f9e9a2e347abddd2c5775502f, type: 3}
  mostrarImagenEsofago: 1
  imagenEsofago: {fileID: 463660936}
  fraseTriggerImagenEsofago: "en el es\xF3fago"
  mostrarImagenExtra: 0
  imagenExtra: {fileID: 0}
  fraseTriggerImagenExtra: comida
  tutorialText: "Ahora mismo est\xE1s dentro del cuerpo de Maitena, espec\xEDficamente
    en el es\xF3fago viajando junto al agua que acaba de tomarse. Te diriges al est\xF3mago\u2026\n\nPero
    tal y como dijo el doctor, no noto nada extra\xF1o en esta parte. De lo \xFAnico
    que van a tener que cuidarse es de los restos de comida que pueden estar viajando
    junto con ustedes. Si chocan con la nave pueden llegar a hacer da\xF1o al motor.
    Pero no se preocupen, les mandar\xE9 unos avisos antes de que aparezcan.\n\nEl
    viaje hasta el est\xF3mago no es largo. Aguanten s\xF3lo un poco y est\xE9n atentos."
  obstacleSpawners: []
  textSpeed: 0.03
  musicManager: {fileID: 192308477}
