--- !u!114 &1198839134
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1198839133}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 97c563798096e8b4f8395bc7f6b9eb0e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  panel: {fileID: 659744851}
  dialogueText: {fileID: 1544312275}
  continueButton: {fileID: 460572865}
  secretariaImage: {fileID: 2125739877}
  idleSprite: {fileID: -2091692870678905501, guid: 0ac7942e9e8934648841f655ed29726b, type: 3}
  talkingSprite: {fileID: 3608271148486519149, guid: bbc8571f9e9a2e347abddd2c5775502f, type: 3}
  tutorialText: "Bienvenido. Est\xE1s dentro del sistema circulatorio en una peque\xF1a
    nave, viajando por las venas del brazo de Denis.\r\n \r\nComo bien dijimos antes,
    la nave simula ser un gl\xF3bulo rojo y por eso el cuerpo no la rechaza, a\xFAn
    as\xED, ten cuidado.\r\n\r\nMu\xE9vete hacia arriba y abajo usando W y S para
    esquivar los gl\xF3bulos rojos que circulan por la sangre.\r\n"
  segundoPanel: {fileID: 944731237}
  segundoTexto: {fileID: 1868882252}
  textoSegundoPanel: "Lo has hecho bien. Ahora que ya lo entiendes, vendr\xE1n m\xE1s
    gl\xF3bulos rojos. \r\n\r\nSi bien la nave simula ser uno, nunca lograr\xE1 comportarse
    como tal, por eso, para no da\xF1ar a Denis tienes que tener mucho cuidado de
    no chocarte con ninguna. Cuida bien a tu paciente.\r\n\r\nPor otro lado, tu objetivo
    es encontrar la Alteplaza, una medicina que te va a ayudar a disipar el problema
    principal de la trombosis.\r\n\r\nMantente alerta\u2026 el sistema no es seguro.\r\n"
  globuloTutorialPrefab: {fileID: 5126030739427055468, guid: 4d906c36ef2edfc4a979b9790f987b9c, type: 3}
  obstacleSpawners:
  - {fileID: 1438938052}
  - {fileID: 1265711417}
  - {fileID: 1712270766}
  textSpeed: 0.01
