  m_Script: {fileID: 11500000, guid: ad5aa10e5efca32438b6d40dd2c77470, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  uiTutorial: {fileID: 826876972}
  dialogueText: {fileID: 417177423}
  continueButton: {fileID: 2051624150}
  secretariaImage: {fileID: 1863746406}
  idleSprite: {fileID: 3362502459059612975, guid: 9757e6632adc96a4c9bbe2fbc15bbf64, type: 3}
  talkingSprite: {fileID: 3608271148486519149, guid: 7c82de84df2153b40b66713d60b2b85c, type: 3}
  imagenNeumococo: {fileID: 81898543}
  imagenBotas: {fileID: 1755079223}
  tutorialText: "\xA1Est\xE1s dentro del cuerpo de Dalia! Ella b\xE1sicamente te
    respir\xF3 a ti y al doctor!\nComo ver\xE1s, est\xE1s controlando un muy peque\xF1o
    robot. Esta herramienta te permitir\xE1 pasar por los bronquios de Dalia.\n\n\xBFVes
    esto? Es el neumococo, un tipo de neumon\xEDa. Con el dr. Jacinto creemos que
    es esta bacteria la que est\xE1 afectando a Dalia.\n\nSi te encuentras con algo
    como esto, no dudes en eliminarlo saltando por arriba de \xE9l, pues las botas
    del robot que manejas tienen un antibacterial que ayudar\xE1 a Dalia. Ten cuidado,
    el sistema no es seguro."
  fraseTriggerImagen1: "\xBFVes esto?"
  fraseTriggerImagen2: Si te encuentras con algo como esto
  obstacleSpawners: []
  textSpeed: 0.03
